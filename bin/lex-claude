#!/usr/bin/env bash
# lex-claude. manage global Claude Code config (identity, hook, skills).
set -euo pipefail

REPO_URL="${LEX_CLAUDE_REPO:-https://github.com/aghribi/lex-claude.git}"
INSTALL_DIR="$HOME/.claude/lex-claude"
CLAUDE_DIR="$HOME/.claude"
SETTINGS="$CLAUDE_DIR/settings.json"
BIN_DIR="$HOME/.local/bin"
BIN_LINK="$BIN_DIR/lex-claude"
BIN_ALIAS="$BIN_DIR/ag"
BIN_PKG="$BIN_DIR/pkgdev"
BIN_MISSION="$BIN_DIR/mission"
BRAND_CMD="${LEX_CLAUDE_BRAND_CMD:-betatron}"   # launcher name: branded `ag claude`
BIN_BRAND="$BIN_DIR/$BRAND_CMD"
CODEX_DIR="${CODEX_DIR:-$HOME/.codex}"
AGENTS_LINK="$CODEX_DIR/AGENTS.md"
CODEX_SKILLS_DIR="$CODEX_DIR/skills"
LANG_FILE="$INSTALL_DIR/.lang"
MODEL_FILE="$INSTALL_DIR/.model"
SKIP_FILE="$INSTALL_DIR/.skip"
BRAND_FILE="$INSTALL_DIR/.brand"
COLDSTART_DIR="$INSTALL_DIR/state/coldstart"
LID_RULE="/etc/sudoers.d/lex-claude-pmset"
# ${BASH_SOURCE[0]:-$0}: BASH_SOURCE is unset when piped (curl | bash -s) and set -u would abort.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

die() { echo "error: $*" >&2; exit 1; }

reset_managed_tree() {
  # Install dir is a deployed artifact, not a workspace. sync_rules and deploy
  # rewrite tracked files; any drift would block git pull. Hard-reset wipes
  # both staged and worktree drift. Untracked files (.last-update-check, etc)
  # are left alone.
  [ -d "$INSTALL_DIR/.git" ] || return 0
  git -C "$INSTALL_DIR" reset --hard HEAD --quiet || true
}

auto_update() {
  [ "${LEX_CLAUDE_NO_AUTO_UPDATE:-}" = "1" ] && return 0
  [ -d "$INSTALL_DIR/.git" ] || return 0
  local marker="$INSTALL_DIR/.last-update-check"
  local now last=0 diff
  now=$(date +%s)
  [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
  diff=$((now - last))
  [ "$diff" -lt 86400 ] && return 0
  echo "$now" > "$marker"
  git -C "$INSTALL_DIR" fetch --quiet origin 2>/dev/null || return 0
  local local_sha remote_sha
  local_sha=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null) || return 0
  remote_sha=$(git -C "$INSTALL_DIR" rev-parse '@{u}' 2>/dev/null) || return 0
  [ "$local_sha" = "$remote_sha" ] && return 0
  echo "lex-claude: newer version on origin. updating..."
  reset_managed_tree
  git -C "$INSTALL_DIR" pull --ff-only --quiet 2>/dev/null || { echo "lex-claude: auto-update failed (non-ff or conflict). run 'ag update' manually" >&2; return 0; }
  # Deploy via the freshly pulled binary, not the stale in-memory functions.
  "$INSTALL_DIR/bin/lex-claude" __deploy >/dev/null
  echo "lex-claude: updated, re-running."
  exec "$INSTALL_DIR/bin/lex-claude" "$@"
}

usage() {
  cat <<EOF
lex-claude. global Claude Code and Codex config manager

Usage:
  lex-claude install [--yes]    Bootstrap: clone, symlink CLAUDE.md and AGENTS.md, wire Claude hooks, deploy skills for Claude Code and Codex. Prompts before overwriting existing files; --yes / LEX_CLAUDE_YES=1 skips the prompt.
  lex-claude install --pkg-only     Install only the pkgdev binary + PATH. Touches no identity/rules/skills/hook.
  lex-claude update             Pull latest and re-deploy.
  lex-claude identity                                List identities (active marked *).
  lex-claude identity <name>                         Switch active identity.
  lex-claude identity new --name <n> --desc "<d>"    Create identity (persona + shared rules).
  lex-claude identity new --name <n> --empty         Create identity without shared rules.
  lex-claude rules sync                              Re-inject RULES.md into all managed identities (deployed install).
  lex-claude rules sync --repo [DIR]                 Same, but against a dev checkout (DIR, default \$PWD). Then commit/push from there.
  lex-claude model                                   Print pinned model (or default).
  lex-claude model list                              Interactive picker: choose a model from the list.
  lex-claude model <name>                            Pin a default model (e.g. opus, sonnet, claude-fable-5).
  lex-claude model off                               Clear pin, back to Claude Code default.
  lex-claude lang                                    Print active language (en/fr/off).
  lex-claude lang en|fr                              Set the language. Hook injects "Respond in X." at SessionStart; statusline shows it.
  lex-claude lang off                                Clear (Claude picks the language).
  lex-claude skip on|off|status                      Toggle shell function wrapper so Claude and Codex bypass approvals and sandboxing.
  lex-claude brand on|off|status                     Run interactive Claude Code behind brand.py: identity name, own logo and terminal title. Name/colour: LEX_CLAUDE_BRAND_NAME, LEX_CLAUDE_BRAND_RGB.
  betatron [args...]                                 Branded 'ag claude' regardless of 'ag brand' (launcher linked by install/update; name: LEX_CLAUDE_BRAND_CMD).
  lex-claude github-login [--token TOKEN]            Wire gh + git auth. No args: auto-detect (already authed -> no-op; GH_TOKEN/GITHUB_TOKEN; device flow if tty; ssh agent for git-only). Also sets git author (user.name/email) when unset or pod default. Idempotent, safe in hooks/rc.
  lex-claude awake [duration]                        Keep Mac awake (caffeinate -dimsu). Examples: 30m, 2h, 1h30m. No arg = until 'awake off'.
  lex-claude awake --while <pid>                     Stay awake while <pid> is alive.
  lex-claude awake --lid [duration|--while <pid>]    Also stay awake with the lid closed (pmset disablesleep, reverted on stop). First use installs a sudoers rule.
  lex-claude awake off|status                        Stop or inspect the assertion.
  lex-claude codex [prompt]                          Launch Codex with active identity + project docs injected as the initial prompt.
  lex-claude codex --print [prompt]                  Print the prompt that would be sent to Codex.
  lex-claude claude [--fast|--verify] [args...]      Launch Claude Code with a verified cold-start: pre-flight a fresh session against the master before handing over the seat (bounded reroll + self-heal). A pass is cached per setup fingerprint for LEX_CLAUDE_COLDSTART_TTL_HOURS (default 24). --verify forces the check, --fast skips it. Alias 'claude' to it to make it your default. Skip: LEX_CLAUDE_COLDSTART_DISABLE=1.
  lex-claude init zsh|bash                           Output shell completion. Add to rc: eval "\$(ag init zsh)".
  lex-claude init claude                             Print the context the SessionStart hook loads into Claude Code.
  lex-claude rag <command> [args...]                 Run the ag-rag indexer (search, stats, update, index, embed, init). See 'ag rag --help'.
  lex-claude usage                                   Report which commands/skills get used (and which never do). Debloat aid.
  lex-claude journal init|show|check|all|root        Per-project journal in <project>/_journal/ (STATUS, RESULTS, session notes). Injected at SessionStart only inside that project.
  lex-claude doctor             Sanity-check the install.
  lex-claude version            Print install version (commit count + date).

Sibling binary (deployed alongside ag):
  pkgdev <pkg>@<branch>         Clone a package branch, editable install (uv pip install -e). Short names: xtrack, cheetah, ...
  pkgdev <owner/repo>@<branch>  Same, from any GitHub repo or git URL.
  pkgdev --quick <spec>         Skip clone: uv pip install --force-reinstall git+...@branch.
  pkgdev --release <pkg>        Back to the PyPI release.
  pkgdev --status <pkg>         Show the installed version and where it comes from.
  mission                       Questionnaire: create missions/mis_<date>_<project>/ and fill the DEMANDE-MISSION docx.
  mission <date> <project> [flags]  Same without questions ('mission --help' lists the flags).
EOF
}

cmd_version() {
  [ -d "$INSTALL_DIR/.git" ] || die "not a git install ($INSTALL_DIR has no .git)"
  local n date
  n=$(git -C "$INSTALL_DIR" rev-list --count HEAD 2>/dev/null) || die "cannot read HEAD"
  date=$(git -C "$INSTALL_DIR" log -1 --format=%cs HEAD 2>/dev/null) || date="?"
  echo "lex-claude v$n ($date)"
}

wire_statusline() {
  local cmd="bash $CLAUDE_DIR/statusline-command.sh"
  if ! command -v jq >/dev/null 2>&1; then
    echo "warn: jq missing. add statusLine manually to $SETTINGS (command: $cmd)"
    return 0
  fi
  [ -f "$SETTINGS" ] || { echo '{}' > "$SETTINGS"; }

  local current
  current=$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null || echo "")
  case "$current" in
    *statusline-command.sh*) echo "statusline: wired (kept)"; return 0 ;;
    "") ;;
    *) echo "statusline: custom command in $SETTINGS (kept). to use lex-claude's, set: $cmd"; return 0 ;;
  esac

  local out; out=$(mktemp 2>/dev/null) || out="/tmp/ag-settings-sl.$$"
  if jq --arg cmd "$cmd" '.statusLine = {"type":"command","command":$cmd}' "$SETTINGS" > "$out" \
     && mv "$out" "$SETTINGS"; then
    echo "statusline: wired"
  else
    echo "warn: jq patch failed. statusLine NOT wired."
    rm -f "$out" 2>/dev/null || true
    return 1
  fi
}

wire_hook() {
  local cmd="bash $INSTALL_DIR/hook.sh"
  local wcmd="bash $INSTALL_DIR/watch.sh"
  local ucmd="bash $INSTALL_DIR/usage.sh hook"
  local dcmd="bash $INSTALL_DIR/digest.sh"
  local dicmd="bash $INSTALL_DIR/direct.sh"
  local scmd="bash $INSTALL_DIR/style.sh"
  local sucmd="bash $INSTALL_DIR/succeed.sh"
  local jcmd="bash $INSTALL_DIR/journal.sh start"
  if ! command -v jq >/dev/null 2>&1; then
    echo "warn: jq missing. add hook manually to $SETTINGS (command: $cmd)"
    return 0
  fi
  mkdir -p "$(dirname "$SETTINGS")" 2>/dev/null || true

  if [ ! -f "$SETTINGS" ]; then
    local tmp; tmp=$(mktemp 2>/dev/null) || tmp="/tmp/ag-settings.$$"
    if ! { echo '{}' > "$tmp" && mv "$tmp" "$SETTINGS"; } 2>/dev/null; then
      echo "warn: cannot write $SETTINGS (open-create blocked by fs?). hook NOT wired."
      echo "diag: $(ls -la "$(dirname "$SETTINGS")" 2>&1 | head -3 | tr '\n' '|')"
      rm -f "$tmp" 2>/dev/null || true
      return 1
    fi
  fi

  local bak="$SETTINGS.bak.$(date +%s)"
  cp "$SETTINGS" "$bak" 2>/dev/null || true

  local out; out=$(mktemp 2>/dev/null) || out="/tmp/ag-settings-out.$$"
  if jq --arg cmd "$cmd" --arg wcmd "$wcmd" --arg ucmd "$ucmd" --arg dcmd "$dcmd" --arg dicmd "$dicmd" --arg scmd "$scmd" --arg sucmd "$sucmd" --arg jcmd "$jcmd" '
    .hooks //= {} |
    .hooks.SessionStart //= [] |
    .hooks.SessionStart = [
      .hooks.SessionStart[]
      | select(all(.hooks[]?; (.command // "") | (test("JeanJean") or test("lex-claude/hook") or test("lex-claude/watch") or test("lex-claude/journal")) | not))
    ] |
    .hooks.SessionStart += [
      {"hooks":[{"type":"command","command":$cmd}]},
      {"hooks":[{"type":"command","command":$wcmd}]},
      {"hooks":[{"type":"command","command":$jcmd}]}
    ] |
    .hooks.FileChanged //= [] |
    .hooks.FileChanged = [
      .hooks.FileChanged[]
      | select(all(.hooks[]?; (.command // "") | test("lex-claude/watch") | not))
    ] |
    .hooks.FileChanged += [{"hooks":[{"type":"command","command":$wcmd}]}] |
    .hooks.PreToolUse //= [] |
    .hooks.PreToolUse = [
      .hooks.PreToolUse[]
      | select(all(.hooks[]?; (.command // "") | (test("lex-claude/usage") or test("lex-claude/handoff") or test("lex-claude/succeed")) | not))
    ] |
    .hooks.PreToolUse += [
      {"matcher":"Skill","hooks":[{"type":"command","command":$ucmd}]}
    ] |
    .hooks.UserPromptSubmit //= [] |
    .hooks.UserPromptSubmit = [
      .hooks.UserPromptSubmit[]
      | select(all(.hooks[]?; (.command // "") | (test("lex-claude/digest") or test("lex-claude/direct")) | not))
    ] |
    .hooks.UserPromptSubmit += [
      {"hooks":[{"type":"command","command":$dicmd,"timeout":120}]},
      {"hooks":[{"type":"command","command":$dcmd}]}
    ] |
    .hooks.PostToolUse //= [] |
    .hooks.PostToolUse = [
      .hooks.PostToolUse[]
      | select(all(.hooks[]?; (.command // "") | (test("lex-claude/style") or test("lex-claude/handoff")) | not))
    ] |
    .hooks.PostToolUse += [
      {"matcher":"Write|Edit|MultiEdit","hooks":[{"type":"command","command":$scmd}]}
    ] |
    .hooks.Stop //= [] |
    .hooks.Stop = [
      .hooks.Stop[]
      | select(all(.hooks[]?; (.command // "") | (test("lex-claude/handoff") or test("lex-claude/succeed")) | not))
    ] |
    .hooks.Stop += [{"hooks":[{"type":"command","command":($sucmd + " check")}]}] |
    .hooks.SessionEnd //= [] |
    .hooks.SessionEnd = [
      .hooks.SessionEnd[]
      | select(all(.hooks[]?; (.command // "") | test("lex-claude/handoff") | not))
    ]
  ' "$SETTINGS" > "$out" && mv "$out" "$SETTINGS"; then
    echo "hook: wired"
  else
    echo "warn: jq patch failed. hook NOT wired. backup at $bak"
    rm -f "$out" 2>/dev/null || true
    return 1
  fi
}

# Mirror the active identity to Codex's global AGENTS.md so AGENTS.md-aware
# harnesses (Codex, etc.) load the same rules natively, no `ag codex` wrapper.
# Follows the CLAUDE.md symlink so it stays in sync on install/update/switch.
sync_agents_md() {
  local src; src=$(readlink "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null || true)
  [ -n "$src" ] && [ -e "$src" ] || return 0
  mkdir -p "$CODEX_DIR"
  # Never clobber a hand-written AGENTS.md; back it up first.
  [ -e "$AGENTS_LINK" ] && [ ! -L "$AGENTS_LINK" ] && cp "$AGENTS_LINK" "$AGENTS_LINK.bak.$(date +%s)"
  ln -sfn "$src" "$AGENTS_LINK"
}

sync_skills() {
  local skills_dir="$1" runtime="$2"
  mkdir -p "$skills_dir"

  for link in "$skills_dir/"*; do
    [ -L "$link" ] || continue
    local target; target=$(readlink "$link")
    [[ "$target" == "$INSTALL_DIR/skills/"* ]] || continue
    [ -e "$target" ] && continue
    rm "$link"
    echo "$runtime skill: removed stale $(basename "$link")"
  done

  for skill in "$INSTALL_DIR"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name=$(basename "$skill")
    local destination="$skills_dir/$name"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
      if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$skill" ]; then
        echo "$runtime skill: $name (kept)"
        continue
      fi
      echo "warn: $runtime skill $name already exists at $destination; left untouched"
      continue
    fi
    ln -s "$skill" "$destination"
    echo "$runtime skill: $name"
  done
}

deploy() {
  mkdir -p "$CLAUDE_DIR/skills" "$BIN_DIR"

  sync_rules

  local target="$CLAUDE_DIR/CLAUDE.md"
  local cur; cur=$(readlink "$target" 2>/dev/null || true)
  if [[ "$cur" == "$INSTALL_DIR/identities/"*.md ]] && [ -e "$cur" ]; then
    echo "identity: $(basename "$cur" .md) (kept)"
  else
    local default_identity=""
    for f in "$INSTALL_DIR"/identities/*.md; do
      [ -e "$f" ] || continue
      default_identity=$(basename "$f" .md)
      break
    done
    [ -n "$default_identity" ] || die "no identities found in $INSTALL_DIR/identities/"
    [ -e "$target" ] && [ ! -L "$target" ] && cp "$target" "$target.bak.$(date +%s)" && echo "backup: $target.bak.*"
    ln -sfn "$INSTALL_DIR/identities/$default_identity.md" "$target"
    echo "identity: $default_identity (linked)"
  fi
  sync_agents_md && echo "codex: $AGENTS_LINK → $(readlink "$AGENTS_LINK")"
  sync_skills "$CLAUDE_DIR/skills" "claude"
  sync_skills "$CODEX_SKILLS_DIR" "codex"

  ln -sfn "$INSTALL_DIR/bin/lex-claude" "$BIN_LINK"
  ln -sfn "$INSTALL_DIR/bin/lex-claude" "$BIN_ALIAS"
  echo "cli: $BIN_LINK (alias: ag)"

  # Never shadow a real command of the same name.
  local other; other=$(type -P "$BRAND_CMD" 2>/dev/null || true)
  if [ -n "$other" ] && [ "$other" != "$BIN_BRAND" ]; then
    echo "cli: $BRAND_CMD skipped ($other already on PATH)"
  elif [ -e "$BIN_BRAND" ] && [ ! -L "$BIN_BRAND" ]; then
    echo "cli: $BRAND_CMD skipped ($BIN_BRAND is not a symlink)"
  else
    ln -sfn "$INSTALL_DIR/bin/lex-claude" "$BIN_BRAND"
    echo "cli: $BIN_BRAND (branded ag claude)"
  fi

  if [ -x "$INSTALL_DIR/bin/pkgdev" ]; then
    ln -sfn "$INSTALL_DIR/bin/pkgdev" "$BIN_PKG"
    echo "cli: $BIN_PKG (Python package branch switcher)"
  fi

  if [ -x "$INSTALL_DIR/bin/mission" ]; then
    ln -sfn "$INSTALL_DIR/bin/mission" "$BIN_MISSION"
    echo "cli: $BIN_MISSION (mission folder + DEMANDE-MISSION request)"
  fi

  local sl_target="$CLAUDE_DIR/statusline-command.sh"
  local sl_src="$INSTALL_DIR/statusline-command.sh"
  if [ -f "$sl_src" ]; then
    if [ -e "$sl_target" ] && [ ! -L "$sl_target" ]; then
      cp "$sl_target" "$sl_target.bak.$(date +%s)"
      echo "backup: $sl_target.bak.*"
    fi
    ln -sfn "$sl_src" "$sl_target"
    echo "statusline: $sl_target"
  fi

  ensure_path_in_rc || true
  _ensure_claude_fn || true   # route `claude` → `ag claude` (cold-start check) always

  wire_hook || echo "note: hook wiring skipped. cli works. run 'ag doctor' to investigate."
  wire_statusline || echo "note: statusline wiring skipped. run 'ag doctor' to investigate."
}

deploy_pkg_only() {
  # Lean install: only the pkgdev binary + PATH. Touches no CLAUDE.md,
  # skills, hook, or statusline. For teammates who just want the branch
  # switcher without the rest of lex-claude.
  mkdir -p "$BIN_DIR"
  [ -x "$INSTALL_DIR/bin/pkgdev" ] || die "pkgdev not found in $INSTALL_DIR/bin"
  ln -sfn "$INSTALL_DIR/bin/pkgdev" "$BIN_PKG"
  echo "cli: $BIN_PKG (Python package branch switcher)"
  ensure_path_in_rc || true
}

cmd_install() {
  local yes=0 pkg_only=0
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      --pkg-only) pkg_only=1 ;;
    esac
  done
  [ "${LEX_CLAUDE_YES:-}" = "1" ] && yes=1

  if [ $pkg_only -eq 1 ]; then
    if [ -d "$INSTALL_DIR/.git" ]; then
      reset_managed_tree
      git -C "$INSTALL_DIR" pull --ff-only
    else
      mkdir -p "$(dirname "$INSTALL_DIR")"
      clone_install
    fi
    deploy_pkg_only
    echo "done. pkgdev only (no identity/rules/skills/hook touched)."
    exit 0
  fi

  local needs_prompt=0
  [ -e "$CLAUDE_DIR/CLAUDE.md" ] && [ ! -L "$CLAUDE_DIR/CLAUDE.md" ] && needs_prompt=1
  [ -f "$SETTINGS" ] && needs_prompt=1

  if [ $needs_prompt -eq 1 ] && [ $yes -eq 0 ]; then
    echo "ag install will modify these existing files (backups will be created):"
    [ -e "$CLAUDE_DIR/CLAUDE.md" ] && [ ! -L "$CLAUDE_DIR/CLAUDE.md" ] && echo "  - $CLAUDE_DIR/CLAUDE.md → backup + replace with symlink to managed identity"
    [ -e "$CLAUDE_DIR/statusline-command.sh" ] && [ ! -L "$CLAUDE_DIR/statusline-command.sh" ] && echo "  - $CLAUDE_DIR/statusline-command.sh → backup + replace with symlink to managed script"
    [ -f "$SETTINGS" ] && echo "  - $SETTINGS → backup + jq-patch SessionStart hook + statusLine"
    if [ -t 0 ]; then
      printf "continue? [y/N] "
      local r; read -r r
      case "$r" in y|Y|yes) ;; *) echo "aborted."; exit 0 ;; esac
    else
      die "not a TTY. Pass --yes (or LEX_CLAUDE_YES=1) to confirm."
    fi
  fi

  if [ -d "$INSTALL_DIR/.git" ]; then
    echo "already installed at $INSTALL_DIR. pulling latest"
    reset_managed_tree
    git -C "$INSTALL_DIR" pull --ff-only
  else
    mkdir -p "$(dirname "$INSTALL_DIR")"
    clone_install
  fi

  if [ "${LEX_CLAUDE_INSTALL_REEXEC:-}" != "1" ] && [ -x "$INSTALL_DIR/bin/lex-claude" ]; then
    if ! cmp -s "$0" "$INSTALL_DIR/bin/lex-claude" 2>/dev/null; then
      echo "install: re-exec on-disk script (curl CDN may serve stale)"
      LEX_CLAUDE_INSTALL_REEXEC=1 LEX_CLAUDE_YES="${LEX_CLAUDE_YES:-1}" exec "$INSTALL_DIR/bin/lex-claude" install
    fi
  fi

  deploy
  echo "done. open a new Claude Code session to load."
}

cmd_update() {
  [ -d "$INSTALL_DIR/.git" ] || die "not installed. run: lex-claude install"
  reset_managed_tree
  git -C "$INSTALL_DIR" pull --ff-only
  # Re-exec the freshly pulled binary for the deploy. Calling the in-memory
  # deploy would run the pre-pull functions (stale wire_hook, etc).
  exec "$INSTALL_DIR/bin/lex-claude" __deploy
}

# Clone into a temp dir, then swap in. A fresh INSTALL_DIR may already hold
# state (usage.log written by the logger before the first clone); keep it.
clone_install() {
  local tmp="$INSTALL_DIR.clone.$$"
  rm -rf "$tmp"
  git clone "$REPO_URL" "$tmp" || { rm -rf "$tmp"; die "clone failed: $REPO_URL"; }
  if [ -d "$INSTALL_DIR" ]; then
    cp -Rn "$INSTALL_DIR"/. "$tmp"/ 2>/dev/null || true
    rm -rf "$INSTALL_DIR"
  fi
  mv "$tmp" "$INSTALL_DIR"
}

sync_rules() {
  local base="${1:-$INSTALL_DIR}"
  [ -f "$base/RULES.md" ] || return 0
  local f n=0
  for f in "$base"/identities/*.md; do
    [ -f "$f" ] || continue
    grep -q '^<!-- LC_RULES_BEGIN -->' "$f" || continue
    {
      awk '/^<!-- LC_RULES_BEGIN -->/{exit} {print}' "$f"
      printf '<!-- LC_RULES_BEGIN -->\n'
      cat "$base/RULES.md"
      printf '<!-- LC_RULES_END -->\n'
      awk 'flag{print} /^<!-- LC_RULES_END -->/{flag=1}' "$f"
    } > "$f.tmp" && mv "$f.tmp" "$f"
    n=$((n+1))
  done
  echo "rules: synced into $n identit$([ $n -eq 1 ] && echo y || echo ies)$([ "$base" = "$INSTALL_DIR" ] || echo " ($base)")"
}

identity_new() {
  local name="" desc="" empty=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name|-name) name="${2:-}"; shift 2 ;;
      --desc|-desc) desc="${2:-}"; shift 2 ;;
      --empty|--force-empty) empty=1; shift ;;
      *) die "unknown flag: $1 (expected --name/--desc/--empty)" ;;
    esac
  done
  [ -n "$name" ] || die "missing --name"
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "name must match [a-zA-Z0-9_-]+"
  local file="$INSTALL_DIR/identities/$name.md"
  [ -e "$file" ] && die "identity '$name' already exists at $file"

  if [ $empty -eq 1 ]; then
    {
      printf 'You are %s.' "$name"
      [ -n "$desc" ] && printf ' %s' "$desc"
      printf '\n'
    } > "$file"
    echo "created (empty, no shared rules): $file"
  else
    [ -n "$desc" ] || die "missing --desc (or use --empty)"
    {
      printf 'You are %s. %s\n\n' "$name" "$desc"
      printf '<!-- LC_RULES_BEGIN -->\n'
      cat "$INSTALL_DIR/RULES.md"
      printf '<!-- LC_RULES_END -->\n'
    } > "$file"
    echo "created with shared rules: $file"
  fi
  echo "next:   \$EDITOR $file"
  echo "switch: ag identity $name"

  if [ -d "$INSTALL_DIR/.git" ]; then
    if git -C "$INSTALL_DIR" add "identities/$name.md" \
       && git -C "$INSTALL_DIR" commit -q -m "add identity: $name" 2>/dev/null; then
      if git -C "$INSTALL_DIR" push -q 2>/dev/null; then
        echo "git:    committed + pushed to origin"
      else
        echo "git:    committed locally (push failed. no remote perms? run 'git -C $INSTALL_DIR push' manually, or: ag github-login --token <TOKEN>)"
      fi
    fi
  fi
}

cmd_rules() {
  local sub="${1:-sync}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    sync)
      local base="$INSTALL_DIR"
      if [ "${1:-}" = "--repo" ]; then
        base="${2:-$PWD}"
        [ -d "$base/identities" ] || die "no identities/ under $base (run from your lex-claude checkout, or: ag rules sync --repo <dir>)"
        [ -f "$base/RULES.md" ] || die "no RULES.md under $base"
      fi
      sync_rules "$base"
      ;;
    *) die "unknown rules subcommand: $sub (expected: sync)" ;;
  esac
}

cmd_lang() {
  case "${1:-}" in
    "")
      if [ -f "$LANG_FILE" ]; then
        local cur; cur=$(cat "$LANG_FILE" 2>/dev/null || echo "")
        [ -n "$cur" ] && echo "lang: $cur" || echo "lang: off"
      else
        echo "lang: off"
      fi
      echo "switch: ag lang en|fr|off"
      ;;
    en|fr)
      mkdir -p "$(dirname "$LANG_FILE")" 2>/dev/null || true
      echo "$1" > "$LANG_FILE"
      echo "lang: $1 (active next session)"
      ;;
    off|none|clear)
      rm -f "$LANG_FILE"
      echo "lang: off"
      ;;
    *) die "unknown lang: $1 (expected: en, fr, off)" ;;
  esac
}

cmd_identity() {
  local target="$CLAUDE_DIR/CLAUDE.md"
  case "${1:-}" in
    "")
      local cur; cur=$(readlink "$target" 2>/dev/null || true)
      for f in "$INSTALL_DIR"/identities/*.md; do
        [ -e "$f" ] || continue
        local n; n=$(basename "$f" .md)
        [ "$cur" = "$f" ] && echo "* $n" || echo "  $n"
      done
      return
      ;;
    new)
      shift; identity_new "$@"
      return
      ;;
  esac
  local src="$INSTALL_DIR/identities/$1.md"
  [ -f "$src" ] || die "identity '$1' not found in $INSTALL_DIR/identities/"
  ln -sfn "$src" "$target"
  sync_agents_md
  echo "switched to: $1"
}

ensure_path_in_rc() {
  case ":$PATH:" in
    *":$BIN_DIR:"*) echo "ok    PATH includes $BIN_DIR"; return 0 ;;
  esac
  local rc=""
  case "$(basename "${SHELL:-}")" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *) echo "warn  unknown shell ($SHELL). add manually: export PATH=\"\$HOME/.local/bin:\$PATH\""; return 1 ;;
  esac
  local line='export PATH="$HOME/.local/bin:$PATH"'
  if [ -f "$rc" ] && grep -Fq "$line" "$rc"; then
    echo "ok    PATH export already in $rc. re-source it: source $rc"
    return 0
  fi
  printf '\n# added by lex-claude\n%s\n' "$line" >> "$rc"
  echo "fix   appended PATH export to $rc. re-source it: source $rc"
}

SKIP_BEGIN_OLD='# >>> lex-claude skip >>>'
SKIP_END_OLD='# <<< lex-claude skip <<<'
FN_BEGIN='# >>> lex-claude claude >>>'
FN_END='# <<< lex-claude claude <<<'
FN_MARK='lex-claude claude router v3'   # bump when _claude_fn_block changes → old blocks get replaced

rc_file() {
  case "$(basename "${SHELL:-}")" in
    zsh)  echo "$HOME/.zshrc" ;;
    bash) echo "$HOME/.bashrc" ;;
    *) return 1 ;;
  esac
}

_strip_rc_block() {
  local rc="$1" begin="$2" end="$3"
  [ -f "$rc" ] && grep -Fq "$begin" "$rc" || return 0
  awk -v b="$begin" -v e="$end" '$0==b{s=1;next} $0==e{s=0;next} !s' "$rc" > "$rc.tmp" && mv "$rc.tmp" "$rc"
}

_claude_fn_block() {
  cat <<'BLOCK'
# lex-claude claude router v3 — routes `claude` through `ag claude` so every
# interactive launch gets the cold-start identity/rules check. Model and skip
# flags are applied by `ag claude` itself. `command claude` bypasses this.
# Terminals that ship their own claude wrapper (cmux) redefine claude() after
# this rc runs, so the router is re-installed before each command (zsh preexec,
# bash PROMPT_COMMAND). `ag claude` resolves claude via PATH, so the terminal's
# shim still wraps the real binary.
_lc_claude_router() {
  claude() { command lex-claude claude "$@"; }
}
_lc_claude_router
if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz add-zsh-hook && add-zsh-hook preexec _lc_claude_router
elif [ -n "${BASH_VERSION:-}" ]; then
  case ";${PROMPT_COMMAND:-};" in
    *";_lc_claude_router;"*) ;;
    *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}_lc_claude_router" ;;
  esac
fi
codex() {
  local _f=()
  [ -f "$HOME/.claude/lex-claude/.skip" ] && _f+=(--dangerously-bypass-approvals-and-sandbox)
  command codex "${_f[@]}" "$@"
}
BLOCK
}

_ensure_claude_fn() {
  local rc
  rc=$(rc_file) || return 1
  # Migrate old skip alias block → dot file
  if [ -f "$rc" ] && grep -Fq "$SKIP_BEGIN_OLD" "$rc"; then
    [ ! -f "$SKIP_FILE" ] && { mkdir -p "$(dirname "$SKIP_FILE")" 2>/dev/null || true; touch "$SKIP_FILE"; }
    _strip_rc_block "$rc" "$SKIP_BEGIN_OLD" "$SKIP_END_OLD"
  fi
  # Current version present? Done. A stale (pre-router) block gets replaced so an
  # existing install picks up the routing on the next `ag update`.
  if [ -f "$rc" ] && grep -Fq "$FN_BEGIN" "$rc"; then
    grep -Fq "$FN_MARK" "$rc" && return 0
    _strip_rc_block "$rc" "$FN_BEGIN" "$FN_END"
  fi
  { printf '\n%s\n' "$FN_BEGIN"; _claude_fn_block; printf '%s\n' "$FN_END"; } >> "$rc"
}

_model_list() {
  cat <<'MODELS'
sonnet	Sonnet 5 (latest)
opus	Opus 5 (latest)
fable	Fable 5 (latest)
haiku	Haiku 4.5
best	auto-select best available
sonnet[1m]	Sonnet 5, 1M context
opus[1m]	Opus 5, 1M context
fable[1m]	Fable 5, 1M context
opusplan	Opus with plan mode
claude-opus-4-8	Opus 4.8
claude-opus-4-8[1m]	Opus 4.8, 1M context
claude-opus-4-7	Opus 4.7
claude-opus-4-7[1m]	Opus 4.7, 1M context
claude-opus-4-6	Opus 4.6
claude-sonnet-4-5-20250514	Sonnet 4.5
claude-haiku-4-5-20251001	Haiku 4.5 (full ID)
MODELS
}

cmd_skip() {
  local rc
  rc=$(rc_file) || die "unknown shell ($SHELL). add manually: alias claude='claude --dangerously-skip-permissions'"
  # Migrate old alias block if present
  if [ -f "$rc" ] && grep -Fq "$SKIP_BEGIN_OLD" "$rc" && [ ! -f "$SKIP_FILE" ]; then
    _ensure_claude_fn
    echo "(migrated skip from alias to function wrapper)"
  fi
  case "${1:-status}" in
    on)
      if [ -f "$SKIP_FILE" ]; then
        echo "skip: already on"
      else
        mkdir -p "$(dirname "$SKIP_FILE")" 2>/dev/null || true
        touch "$SKIP_FILE"
        _ensure_claude_fn
        echo "skip: on. Claude skips permissions; Codex bypasses approvals and sandboxing"
      fi
      echo "re-source: source $rc  (or open a new shell)"
      ;;
    off)
      if [ -f "$SKIP_FILE" ]; then
        rm -f "$SKIP_FILE"
        echo "skip: off (takes effect on the next claude/codex launch)"
      else
        echo "skip: already off"
      fi
      ;;
    status|"")
      [ -f "$SKIP_FILE" ] && echo "skip: on" || echo "skip: off"
      echo "toggle: ag skip on|off"
      ;;
    *) die "unknown skip arg: $1 (expected: on, off, status)" ;;
  esac
}

cmd_brand() {
  case "${1:-status}" in
    on)
      command -v uv >/dev/null 2>&1 || die "brand needs uv (brand.py runs through uv)"
      mkdir -p "$(dirname "$BRAND_FILE")" 2>/dev/null || true
      touch "$BRAND_FILE"
      echo "brand: on (next interactive claude launch shows $(_brand_name))"
      ;;
    off)
      rm -f "$BRAND_FILE"
      echo "brand: off (next launch shows the stock banner)"
      ;;
    status)
      [ -f "$BRAND_FILE" ] && echo "brand: on ($(_brand_name))" || echo "brand: off"
      echo "toggle: ag brand on|off"
      ;;
    *) die "unknown brand arg: $1 (expected: on, off, status)" ;;
  esac
}

# Banner name: LEX_CLAUDE_BRAND_NAME, else the active identity, capitalised.
_brand_name() {
  [ -n "${LEX_CLAUDE_BRAND_NAME:-}" ] && { printf '%s' "$LEX_CLAUDE_BRAND_NAME"; return; }
  local n; n=$(basename "$(readlink "$CLAUDE_DIR/CLAUDE.md" 2>/dev/null)" .md)
  [ -n "$n" ] || n="lex-claude"
  printf '%s%s' "$(printf '%s' "${n:0:1}" | tr '[:lower:]' '[:upper:]')" "${n:1}"
}

cmd_model() {
  case "${1:-}" in
    "")
      if [ -f "$MODEL_FILE" ]; then
        local cur; cur=$(cat "$MODEL_FILE" 2>/dev/null || echo "")
        [ -n "$cur" ] && echo "model: $cur" || echo "model: default"
      else
        echo "model: default"
      fi
      echo "pin: ag model <name>    list: ag model list    clear: ag model off"
      ;;
    list)
      local current="default"
      [ -f "$MODEL_FILE" ] && current=$(cat "$MODEL_FILE" 2>/dev/null)
      if [ -t 0 ] && [ -t 1 ]; then
        local picked=""
        if command -v fzf >/dev/null 2>&1; then
          picked=$(_model_list | fzf --prompt="model> " --header="current: $current" \
            --delimiter=$'\t' --with-nth=1,2 --tabstop=28 \
            --preview-window=hidden | cut -f1)
        else
          local -a ids; local line
          while IFS=$'\t' read -r id _desc; do ids+=("$id"); done < <(_model_list)
          echo "pick a model (current: $current):"
          select m in "${ids[@]}" "(cancel)"; do
            [ "$m" = "(cancel)" ] || [ -z "$m" ] && break
            picked="$m"; break
          done
        fi
        if [ -n "$picked" ]; then
          local rc; rc=$(rc_file) || die "unknown shell"
          mkdir -p "$(dirname "$MODEL_FILE")" 2>/dev/null || true
          printf '%s' "$picked" > "$MODEL_FILE"
          _ensure_claude_fn
          echo "model: $picked"
          echo "re-source: source $rc  (or open a new shell)"
        fi
      else
        _model_list | column -t -s $'\t' 2>/dev/null || _model_list
        echo "pinned: $current"
      fi
      ;;
    off|default|clear|none)
      rm -f "$MODEL_FILE"
      echo "model: default (takes effect on the next claude launch)"
      ;;
    *)
      local rc
      rc=$(rc_file) || die "unknown shell ($SHELL). can't set model wrapper"
      mkdir -p "$(dirname "$MODEL_FILE")" 2>/dev/null || true
      printf '%s' "$1" > "$MODEL_FILE"
      _ensure_claude_fn
      echo "model: $1"
      echo "re-source: source $rc  (or open a new shell)"
      ;;
  esac
}

# Hopsworks pods boot preconfigured as "Admin Admin <admin@hopsworks.ai>";
# that default is as good as unset. A real identity is never overwritten.
github_set_identity() {
  local who="$1"
  [ -n "$who" ] && [ "$who" != "?" ] || return 0
  command -v git >/dev/null 2>&1 || return 0
  local cur_name cur_email
  cur_name=$(git config --global user.name 2>/dev/null || true)
  cur_email=$(git config --global user.email 2>/dev/null || true)
  [ "$cur_name" = "Admin Admin" ] && cur_name=""
  [ "$cur_email" = "admin@hopsworks.ai" ] && cur_email=""
  if [ -n "$cur_name" ] && [ -n "$cur_email" ]; then return 0; fi
  local email="$who@users.noreply.github.com"
  if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
    local gh_email gh_id
    gh_email=$(gh api user --jq '.email // empty' 2>/dev/null || true)
    gh_id=$(gh api user --jq .id 2>/dev/null || true)
    if [ -n "$gh_email" ]; then email="$gh_email"
    elif [ -n "$gh_id" ]; then email="$gh_id+$who@users.noreply.github.com"; fi
  fi
  if [ -z "$cur_email" ]; then
    git config --global user.email "$email"
    echo "git: set user.email to $email (override with: git config --global user.email ...)"
  fi
  if [ -z "$cur_name" ]; then
    git config --global user.name "$who"
    echo "git: set user.name to $who"
  fi
}

# A stored https credential must not be shadowed by a stale ssh rewrite:
# ssh dies with the forwarded agent, the token does not.
github_drop_ssh_rewrite() {
  git config --global --unset "url.git@github.com:.insteadOf" 2>/dev/null || true
}

github_ssh_user() {
  # github always closes with exit 1; success is the greeting on stderr.
  command -v ssh >/dev/null 2>&1 || return 0
  ssh -T git@github.com -o BatchMode=yes -o ConnectTimeout=5 2>&1 \
    | sed -n 's/^Hi \([^!]*\)!.*successfully authenticated.*/\1/p' | head -n1 || true
}

github_login_token() {
  local token="$1"
  [ -n "$token" ] || die "empty token."
  if command -v gh >/dev/null 2>&1; then
    printf '%s' "$token" | gh auth login --with-token --hostname github.com
    gh auth setup-git
    github_drop_ssh_rewrite
    local user; user=$(gh api user --jq .login 2>/dev/null || echo "?")
    echo "gh: authenticated as $user"
    echo "git: gh credential helper wired for github.com"
    github_set_identity "$user"
  else
    git config --global credential.helper store
    local user
    user=$(curl -fsSL -H "Authorization: token $token" https://api.github.com/user 2>/dev/null \
           | sed -n 's/.*"login": *"\([^"]*\)".*/\1/p' | head -n1) || true
    [ -n "$user" ] || die "token rejected by github api. check scope/expiry."
    github_drop_ssh_rewrite
    {
      printf 'https://%s:%s@github.com\n' "$user" "$token"
    } > "$HOME/.git-credentials"
    chmod 600 "$HOME/.git-credentials"
    echo "git: stored credentials in ~/.git-credentials as $user"
    echo "note: install gh for richer auth (PRs, issues). brew install gh / apt install gh."
    github_set_identity "$user"
  fi
}

cmd_github_login() {
  local token=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --token|-t) token="${2:-}"; shift 2 ;;
      *) die "unknown flag: $1 (expected --token)" ;;
    esac
  done

  # explicit token always wins (re-provisioning, rotation)
  if [ -n "$token" ]; then github_login_token "$token"; return 0; fi

  # already wired: cheap no-op, safe to run from hooks/rc on every boot
  if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
    local user; user=$(gh api user --jq .login 2>/dev/null || echo "?")
    echo "gh: already authenticated as $user. nothing to do."
    github_set_identity "$user"
    return 0
  fi

  token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  if [ -n "$token" ]; then github_login_token "$token"; return 0; fi

  # device flow: persists in ~/.config/gh, survives restarts and disconnects.
  # preferred over the ssh rewrite whenever a human is attached.
  if [ -t 0 ] && command -v gh >/dev/null 2>&1; then
    echo "gh: no auth found. starting device flow (open the code in any browser)..."
    gh auth login --web --hostname github.com --git-protocol https
    gh auth setup-git
    github_drop_ssh_rewrite
    local user; user=$(gh api user --jq .login 2>/dev/null || echo "?")
    echo "gh: authenticated as $user. token persisted in ~/.config/gh (survives restarts)."
    github_set_identity "$user"
    return 0
  fi

  # no tty: a forwarded ssh agent still covers git for the current session
  local ssh_user; ssh_user=$(github_ssh_user)
  if [ -n "$ssh_user" ]; then
    git config --global "url.git@github.com:.insteadOf" "https://github.com/"
    echo "git: ssh agent answers as $ssh_user. https github remotes rewritten to ssh (nothing stored)."
    echo "gh: api not authenticated. for headless gh set GH_TOKEN, or run 'ag github-login' from a terminal."
    github_set_identity "$ssh_user"
    return 0
  fi

  # tty without gh: token is the only remaining path
  if [ -t 0 ]; then
    printf "github personal access token (input hidden): "
    stty -echo 2>/dev/null || true
    read -r token
    stty echo 2>/dev/null || true
    printf '\n'
    github_login_token "$token"
    return 0
  fi

  die "no auth path: gh not authenticated, no GH_TOKEN/GITHUB_TOKEN, no ssh agent, no tty for device flow."
}

_sleep_disabled() {
  [ "$(pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $2}')" = "1" ]
}

# Kill an awake holder and wait for it to exit, so a --lid wrapper finishes its
# disablesleep revert before anything else touches the flag.
_awake_kill() {
  kill "$1" 2>/dev/null || return 0
  local i
  for i in $(seq 1 50); do
    kill -0 "$1" 2>/dev/null || return 0
    sleep 0.1
  done
  echo "awake: pid $1 did not exit within 5s" >&2
}

_awake_lid_on() {
  sudo -n /usr/bin/pmset -a disablesleep 1 2>/dev/null && return
  [ -t 0 ] || die "awake --lid: first run installs a sudoers rule and needs your sudo password. run it once in a terminal"
  echo "awake: --lid installs $LID_RULE (one-time), allowing only 'pmset -a disablesleep 0|1' without a password"
  local tmp; tmp=$(mktemp)
  printf '%s\n' "# managed by lex-claude (ag awake --lid)" \
    "$(id -un) ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1" > "$tmp"
  visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; die "awake --lid: generated sudoers rule failed visudo validation"; }
  sudo install -m 0440 -o root -g wheel "$tmp" "$LID_RULE" || { rm -f "$tmp"; die "awake --lid: could not install $LID_RULE"; }
  rm -f "$tmp"
  sudo -n /usr/bin/pmset -a disablesleep 1 || die "awake --lid: $LID_RULE installed but pmset still asks for a password"
}

cmd_awake() {
  local pid_file="$HOME/.cache/lex-claude/awake.pid"
  mkdir -p "$(dirname "$pid_file")" 2>/dev/null || true

  case "${1:-}" in
    off|stop)
      if [ -f "$pid_file" ]; then
        local pid; pid=$(cat "$pid_file" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          _awake_kill "$pid"
          rm -f "$pid_file"
          echo "awake: stopped (pid $pid)"
        else
          rm -f "$pid_file"
          echo "awake: not active (stale pidfile cleared)"
        fi
      else
        echo "awake: not active"
      fi
      _sleep_disabled && echo "awake: SleepDisabled is still 1. revert: sudo pmset -a disablesleep 0"
      return 0
      ;;
    status)
      if [ -f "$pid_file" ]; then
        local pid; pid=$(cat "$pid_file" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          # --lid runs caffeinate under a revert wrapper; show caffeinate itself.
          local shown; shown=$(pgrep -P "$pid" caffeinate 2>/dev/null | head -1 || true)
          local cmdline; cmdline=$(ps -p "${shown:-$pid}" -o command= 2>/dev/null | sed 's/^ *//')
          local started; started=$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//')
          echo "awake: active (pid $pid)"
          echo "       started: $started"
          echo "       command: $cmdline"
          _sleep_disabled && echo "       lid: closing the lid will not sleep (SleepDisabled 1)"
          return 0
        fi
        rm -f "$pid_file"
      fi
      echo "awake: not active"
      _sleep_disabled && echo "awake: SleepDisabled is 1 with nothing holding it. revert: sudo pmset -a disablesleep 0"
      return 0
      ;;
    -h|--help|help)
      cat <<'EOF'
ag awake. keep this Mac from sleeping while idle.

Usage:
  ag awake [duration]        run until duration elapses (default: until 'ag awake off')
  ag awake --while <pid>     stay awake while <pid> is alive
  ag awake --lid [...]       same, and keep running with the lid closed
  ag awake off               stop the active assertion
  ag awake status            show whether an assertion is held

Duration:
  Examples: 30m, 2h, 1h30m, 45s, or raw seconds. Empty = no timeout.

Mechanism:
  Wraps `caffeinate -dimsu`. Blocks display sleep, idle sleep, disk sleep, and
  declares the user active. Caffeinate does not cover the lid: without --lid,
  closing it still sleeps the Mac.

--lid:
  Sets `pmset -a disablesleep 1` (works on battery, verified on Apple Silicon)
  and reverts it to 0 when the assertion ends: off, timeout, or --while pid exit.
  The first run installs /etc/sudoers.d/lex-claude-pmset, allowing only
  `pmset -a disablesleep 0|1` without a password. That run asks for your sudo
  password once, so it needs a terminal. A closed Mac in a bag keeps running
  hot until the assertion ends: give --lid a duration or a --while pid.
EOF
      return
      ;;
  esac

  command -v caffeinate >/dev/null 2>&1 || die "caffeinate not found (macOS-only command)"

  local target_pid="" duration_str="" lid=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --lid)
        lid=1
        shift
        ;;
      --while|-w)
        target_pid="${2:-}"
        [ -n "$target_pid" ] || die "--while requires a pid"
        kill -0 "$target_pid" 2>/dev/null || die "no such pid: $target_pid"
        shift 2
        ;;
      *)
        [ -z "$duration_str" ] || die "unexpected arg: $1"
        duration_str="$1"
        shift
        ;;
    esac
  done

  local seconds=0
  if [ -n "$duration_str" ]; then
    if [[ "$duration_str" =~ ^[0-9]+$ ]]; then
      seconds=$duration_str
    else
      local rest="$duration_str"
      while [ -n "$rest" ]; do
        if [[ "$rest" =~ ^([0-9]+)([smhd])(.*)$ ]]; then
          local n=${BASH_REMATCH[1]} u=${BASH_REMATCH[2]}
          rest=${BASH_REMATCH[3]}
          case "$u" in
            s) seconds=$((seconds + n)) ;;
            m) seconds=$((seconds + n * 60)) ;;
            h) seconds=$((seconds + n * 3600)) ;;
            d) seconds=$((seconds + n * 86400)) ;;
          esac
        else
          die "invalid duration: $duration_str (expected: 30m, 2h, 1h30m, 45s, or raw seconds)"
        fi
      done
    fi
  fi

  if [ -f "$pid_file" ]; then
    local old; old=$(cat "$pid_file" 2>/dev/null || echo "")
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
      _awake_kill "$old"
      echo "awake: replaced previous assertion (pid $old)"
    fi
    rm -f "$pid_file"
  fi

  local args=(-dimsu)
  if [ -n "$target_pid" ]; then
    args+=(-w "$target_pid")
  elif [ "$seconds" -gt 0 ]; then
    args+=(-t "$seconds")
  fi

  if [ "$lid" -eq 1 ]; then
    _awake_lid_on
    nohup bash -c 'caffeinate "$@" & c=$!
      trap "kill $c 2>/dev/null" TERM INT
      wait $c; wait $c 2>/dev/null
      sudo -n /usr/bin/pmset -a disablesleep 0' ag-awake "${args[@]}" >/dev/null 2>&1 &
  else
    nohup caffeinate "${args[@]}" >/dev/null 2>&1 &
  fi
  local pid=$!
  disown "$pid" 2>/dev/null || true
  echo "$pid" > "$pid_file"
  [ "$lid" -eq 1 ] && echo "awake: lid-closed sleep disabled until this assertion ends"

  if [ -n "$target_pid" ]; then
    echo "awake: pid $pid, while pid $target_pid is alive"
  elif [ "$seconds" -gt 0 ]; then
    local h=$((seconds / 3600)) m=$(((seconds % 3600) / 60)) s=$((seconds % 60))
    local human=""
    [ "$h" -gt 0 ] && human="${human}${h}h"
    [ "$m" -gt 0 ] && human="${human}${m}m"
    [ "$s" -gt 0 ] && human="${human}${s}s"
    [ -z "$human" ] && human="${seconds}s"
    echo "awake: pid $pid, for $human"
  else
    echo "awake: pid $pid, no timeout. stop with: ag awake off"
  fi
}

cmd_codex() {
  local print_only=0
  local context_mode="full"
  while [ $# -gt 0 ]; do
    case "${1:-}" in
      --print) print_only=1; shift ;;
      --lite) context_mode="lite"; shift ;;
      --full) context_mode="full"; shift ;;
      -h|--help|help)
      cat <<'EOF'
ag codex. launch Codex with lex-claude context preloaded.

Usage:
  ag codex [--lite|--full] [prompt]
  ag codex --print [--lite|--full] [prompt]

Behavior:
  Builds the same context as the Claude SessionStart hook.
  --full loads: active identity, project CLAUDE.md, docs/*, ag command reference, and lang.
  --lite loads: active identity, project CLAUDE.md, ag command reference, and lang.
  Then launches `codex` with that bundle as the initial prompt.
EOF
      return
      ;;
      --*) die "unknown flag: $1 (expected --print, --lite, --full)" ;;
      *) break ;;
    esac
  done

  local hook_script="$SELF_DIR/hook.sh"
  [ -f "$hook_script" ] || hook_script="$INSTALL_DIR/hook.sh"
  [ -f "$hook_script" ] || die "hook.sh not found"

  local prompt=""
  prompt="$(LEX_CLAUDE_CONTEXT_MODE="$context_mode" CLAUDE_PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}" bash "$hook_script")" || die "failed to build Codex prompt"

  if [ $# -gt 0 ]; then
    prompt="${prompt}

===== user prompt =====
$*"
  fi

  if [ $print_only -eq 1 ]; then
    printf '%s\n' "$prompt"
    return
  fi

  command -v codex >/dev/null 2>&1 || die "codex not found on PATH"
  exec codex "$prompt"
}

cmd_init() {
  case "${1:-help}" in
    zsh)
      cat <<'EOF'
# lex-claude zsh completion. Add to ~/.zshrc: eval "$(ag init zsh)"
_ag() {
  local -a cmds awake_cmds init_cmds identity_cmds rules_cmds codex_cmds install_cmds model_cmds lang_cmds skip_cmds brand_cmds rag_cmds
  cmds=(
    'install:bootstrap clone + symlinks + hooks'
    'update:pull latest and redeploy'
    'identity:manage active identity'
    'rules:sync RULES.md across identities'
    'model:pin default Claude model'
    'lang:set Claude reply language (en|fr|off)'
    'skip:toggle Claude and Codex bypass aliases'
    'brand:own logo, name and title on the Claude Code banner'
    'github-login:wire gh + git auth (auto-detect, idempotent)'
    'awake:keep Mac awake (caffeinate wrapper)'
    'codex:launch Codex with lex-claude context preloaded'
    'claude:launch Claude Code with a verified cold-start (master pre-flight)'
    'init:shell completion + context dump'
    'rag:ag-rag indexer (search, stats, update)'
    'usage:report used / never-used commands + skills'
    'doctor:sanity-check the install'
    'version:print install version'
  )
  awake_cmds=('off:stop' 'status:inspect' 'help:show help' '--while:tie to a pid' '--lid:also stay awake lid-closed')
  codex_cmds=('--print:dump the generated prompt' '--lite:load identity + project CLAUDE.md only' '--full:load full docs bundle' 'help:show help')
  init_cmds=('zsh:zsh completion' 'bash:bash completion' 'claude:dump SessionStart context')
  install_cmds=('--yes:skip overwrite prompt' '--pkg-only:install only the pkgdev binary')
  identity_cmds=('new:create a new identity')
  rules_cmds=('sync:re-inject RULES.md')
  model_cmds=('list:interactive model picker' 'off:clear pin (back to default)' 'sonnet:Claude Sonnet' 'opus:Claude Opus' 'haiku:Claude Haiku' 'fable:Claude Fable')
  lang_cmds=('en:English' 'fr:French' 'off:clear (Claude picks)')
  skip_cmds=('on:enable' 'off:disable' 'status:show current state')
  brand_cmds=('on:enable' 'off:disable' 'status:show current state')
  rag_cmds=('search:hybrid search' 'stats:counts and freshness' 'update:index then embed' 'index:keyword index only' 'embed:add missing vectors' 'init:write default config')
  local state
  _arguments -C '1: :->cmd' '*::arg:->args'
  case $state in
    cmd) _describe 'subcommand' cmds ;;
    args)
      case $words[1] in
        install)  _describe 'install' install_cmds ;;
        awake)    _describe 'awake' awake_cmds ;;
        codex)    _describe 'codex' codex_cmds ;;
        init)     _describe 'init target' init_cmds ;;
        identity) _describe 'identity action' identity_cmds ;;
        rules)    _describe 'rules action' rules_cmds ;;
        model)    _describe 'model' model_cmds ;;
        lang)     _describe 'lang' lang_cmds ;;
        skip)     _describe 'skip' skip_cmds ;;
        brand)    _describe 'brand' brand_cmds ;;
        rag)      _describe 'rag' rag_cmds ;;
      esac
      ;;
  esac
}
compdef _ag ag
compdef _ag lex-claude
EOF
      ;;
    bash)
      cat <<'EOF'
# lex-claude bash completion. Add to ~/.bashrc: eval "$(ag init bash)"
_ag() {
  local cur prev cmds
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmds="install update identity rules model lang skip brand github-login awake codex claude init rag usage doctor version"
  case "$prev" in
    ag|lex-claude) COMPREPLY=( $(compgen -W "$cmds" -- "$cur") ) ;;
    install)       COMPREPLY=( $(compgen -W "--yes --pkg-only" -- "$cur") ) ;;
    awake)         COMPREPLY=( $(compgen -W "off status help --while --lid" -- "$cur") ) ;;
    codex)         COMPREPLY=( $(compgen -W "--print --lite --full help" -- "$cur") ) ;;
    init)          COMPREPLY=( $(compgen -W "zsh bash claude" -- "$cur") ) ;;
    identity)      COMPREPLY=( $(compgen -W "new" -- "$cur") ) ;;
    rules)         COMPREPLY=( $(compgen -W "sync" -- "$cur") ) ;;
    model)         COMPREPLY=( $(compgen -W "list off sonnet opus haiku fable best" -- "$cur") ) ;;
    lang)          COMPREPLY=( $(compgen -W "en fr off" -- "$cur") ) ;;
    skip)          COMPREPLY=( $(compgen -W "on off status" -- "$cur") ) ;;
    brand)         COMPREPLY=( $(compgen -W "on off status" -- "$cur") ) ;;
    rag)           COMPREPLY=( $(compgen -W "search stats update index embed init" -- "$cur") ) ;;
  esac
}
complete -F _ag ag
complete -F _ag lex-claude
EOF
      ;;
    claude)
      cat <<'EOF'
The user has `ag` (alias of `lex-claude`) installed locally. It manages the
global Claude Code config: identity, rules, hooks, skills, statusline.

Available subcommands (run with `ag <cmd>`):

- `identity`                                  list identities (active marked *)
- `identity <name>`                           switch active identity
- `identity new --name <n> --desc "<d>"`      create identity (with shared rules)
- `identity new --name <n> --empty`           create identity (no shared rules)
- `rules sync`                                re-inject RULES.md into all identities (deployed install)
- `rules sync --repo [DIR]`                   re-inject in a dev checkout (DIR, default $PWD), then commit there
- `model`                                     show pinned model (or default)
- `model list`                                interactive picker: choose from available models
- `model <name>`                              pin a default model (opus, sonnet, fable, haiku, best, or full ID)
- `model off`                                 clear pin, back to Claude Code default
- `lang [en|fr|off]`                          set reply language (hook injects, statusline shows)
- `skip on|off|status`                        toggle shell wrapper for Claude and Codex permission bypass
- `brand on|off|status`                       own logo, identity name and terminal title on the Claude Code banner (brand.py PTY proxy)
- `betatron [args]`                           branded `ag claude`, whatever `ag brand` says (sibling launcher in ~/.local/bin)
- `claude [--fast|--verify] [args]`           cold-start check, cached per setup fingerprint; --verify forces it, --fast skips it
- `awake [30m|2h|1h30m|45s|N]`                keep Mac awake (caffeinate -dimsu)
- `awake --while <pid>`                       stay awake while pid is alive
- `awake --lid [duration|--while <pid>]`      also stay awake lid-closed (pmset disablesleep, reverted on stop)
- `awake off`                                 stop the active assertion
- `awake status`                              inspect (shows pid, started, command)
- `codex [--lite|--full] [prompt]`            launch Codex with lex-claude context preloaded
- `codex --print [--lite|--full] [prompt]`    print the generated Codex prompt
- `init zsh|bash`                             output shell completion
- `init claude`                               print this command reference
- `github-login [--token TOKEN]`              wire gh + git auth (no args = auto-detect: authed/env/device-flow/ssh; idempotent). Also sets git author when unset or pod default
- `rag search "<query>" [-k 8] [--scope S]`    hybrid search over the user's indexed documents
- `rag stats`                                 index counts and freshness
- `rag update|index|embed [--scope S] [--prune] [--minutes M]`  refresh the index (one run at a time)
- `usage`                                     report which commands + skills get used (never-used = debloat candidates)
- `doctor`                                    sanity-check the install
- `update`                                    pull latest + redeploy
- `version`                                   print install version

Sibling binary `pkgdev` (deployed alongside `ag`, points a Python package
in the active env at a git branch):

- `pkgdev <pkg>@<branch>`                      clone the branch, editable install (short names: xtrack, xpart, xobjects, xfields, xdeps, xwakes, xcoll, cheetah)
- `pkgdev <owner/repo>@<branch>`               same, from any GitHub repo (or a full git URL)
- `pkgdev --quick <spec>`                      skip clone: uv pip install --force-reinstall git+...@branch
- `pkgdev --release <pkg>`                     back to the PyPI release
- `pkgdev --status <pkg>`                      installed version and source
- `ag install --pkg-only`                      install just `pkgdev` (no identity/rules/skills/hook)

Sibling binary `mission` (deployed alongside `ag`): run bare in a terminal for the
questionnaire, or `mission <YYYYMMDD> <project> [flags]` non-interactively
(`mission --help`). Creates `missions/mis_<date>_<project>/{_demande,_om,_reservations,_invoices}`
and fills `_demande/DEMANDE-MISSION_<date>_<project>.docx` from the template.

Notes:
- Plain `ag awake` does not survive closing the lid: caffeinate assertions do
  not cover it. `ag awake --lid` does (pmset disablesleep, verified on Apple
  Silicon on battery) and reverts it when the assertion ends (off, timeout,
  --while pid exit). Its first run installs /etc/sudoers.d/lex-claude-pmset,
  which allows only `pmset -a disablesleep 0|1` without a password; that one
  run needs a terminal for the sudo prompt. Clamshell mode is the other path.
- The active identity (and its rules) is symlinked at ~/.claude/CLAUDE.md.
- The statusline at ~/.claude/statusline-command.sh is also managed (renders
  dir, git status, identity, lang (if set), a token meter that turns red
  past LEX_CLAUDE_DUMB_ZONE_TOKENS, default 300000, and on a successor its
  lineage: genN plus the predecessor's short id).
- A condensed rules digest (DIGEST.md) is re-injected every Nth prompt
  (LEX_CLAUDE_DIGEST_EVERY, default 5) to keep the rules salient in long
  sessions. Treat it as recall, not new instructions.
- Session flow: identity/rules loading is verified live by a "master" judge
  (master.sh), a neutral session spawned on demand. Cold start goes through 'ag claude', which pre-flights a fresh session
  against the master before handing over the seat (bounded reroll + self-heal on
  failure). A pass is cached per fingerprint of the loaded inputs (identity,
  project CLAUDE.md chain, hooks, lex-claude and claude versions, flags) for
  LEX_CLAUDE_COLDSTART_TTL_HOURS (default 24, 0 = always check); outcomes are
  logged in state/coldstart/log. Near the token limit (LEX_CLAUDE_HANDOFF_TOKENS, default 600000) a
  Stop hook (succeed.sh check) triggers the ag-succession skill: it spawns a
  fresh successor, the master verifies identity + project understanding, rerolls
  a fresh one on any failure, opens the verified one in a new terminal window
  with a kickoff prompt (it starts working on its own), and stands down. In continue mode the master then watches the successor's
  first turns (LEX_CLAUDE_WATCH_TURNS, default 3) against the briefing via its
  Stop hook and blocks once with the reason if it drifts off track, while the
  predecessor stays in tutelle: it peeks at the successor's transcript
  (Monitor on succeed.sh peek, one event per finished turn) and corrects it
  over SendMessage. Kill:
  LEX_CLAUDE_HANDOFF_DISABLE=1.
- This reference is auto-loaded at session start by the SessionStart hook.
EOF
      ;;
    help|-h|--help|"")
      cat <<EOF
ag init. shell completion and Claude Code context dump.

Usage:
  ag init zsh       output zsh completion. Add to ~/.zshrc:
                      eval "\$(ag init zsh)"
  ag init bash      output bash completion. Add to ~/.bashrc:
                      eval "\$(ag init bash)"
  ag init claude    print the lex-claude command reference. The SessionStart
                    hook auto-injects this so Claude Code knows about \`ag\`
                    in every session. Run manually for inspection or piping.
EOF
      ;;
    *)
      die "unknown init target: $1 (expected: zsh, bash, claude)"
      ;;
  esac
}

# True if any hook command in settings.json matches the substring. Uses jq so it
# survives JSON that escapes forward slashes (lex-claude\/usage.sh), which a plain
# grep on the raw file misses. Falls back to grep (both forms) if jq is absent.
_hook_wired() {
  if command -v jq >/dev/null 2>&1; then
    jq -e --arg n "$1" '[.. | .command? // empty | select(type=="string" and (contains($n)))] | length > 0' "$SETTINGS" >/dev/null 2>&1
  else
    grep -q "$1" "$SETTINGS" 2>/dev/null || grep -q "${1//\//\\/}" "$SETTINGS" 2>/dev/null
  fi
}

cmd_doctor() {
  local ok=1
  if [ -d "$INSTALL_DIR/.git" ]; then
    local n date
    n=$(git -C "$INSTALL_DIR" rev-list --count HEAD 2>/dev/null || echo '?')
    date=$(git -C "$INSTALL_DIR" log -1 --format=%cs HEAD 2>/dev/null || echo '?')
    echo "ok    version v$n ($date)"
  else
    echo "warn  $INSTALL_DIR has no .git. version unknown"
  fi
  if [ -L "$CLAUDE_DIR/CLAUDE.md" ] && [ -e "$CLAUDE_DIR/CLAUDE.md" ]; then
    echo "ok    CLAUDE.md → $(readlink "$CLAUDE_DIR/CLAUDE.md")"
  else
    echo "fail  CLAUDE.md not linked"; ok=0
  fi
  if [ -L "$AGENTS_LINK" ] && [ -e "$AGENTS_LINK" ]; then
    echo "ok    AGENTS.md → $(readlink "$AGENTS_LINK")"
  else
    echo "warn  codex AGENTS.md not linked (run 'ag update')"
  fi
  for skill in "$INSTALL_DIR"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name=$(basename "$skill")
    [ -L "$CLAUDE_DIR/skills/$name" ] && echo "ok    skill $name" || { echo "fail  skill $name"; ok=0; }
    [ -L "$CODEX_SKILLS_DIR/$name" ] && echo "ok    codex skill $name" || { echo "fail  codex skill $name"; ok=0; }
  done
  _hook_wired "lex-claude/hook" && echo "ok    hook wired" || { echo "fail  hook not wired"; ok=0; }
  if [ -L "$CLAUDE_DIR/statusline-command.sh" ] && [ -e "$CLAUDE_DIR/statusline-command.sh" ]; then
    echo "ok    statusline → $(readlink "$CLAUDE_DIR/statusline-command.sh")"
  else
    echo "warn  statusline not symlinked"
  fi
  grep -q "statusline-command.sh" "$SETTINGS" 2>/dev/null && echo "ok    statusline wired" || echo "warn  statusline not wired in $SETTINGS"
  [ -L "$BIN_LINK" ] && echo "ok    cli ($BIN_LINK)" || { echo "fail  cli not symlinked"; ok=0; }
  [ -L "$BIN_ALIAS" ] && echo "ok    alias ag → lex-claude" || { echo "fail  alias 'ag' not symlinked"; ok=0; }
  if [ -L "$BIN_PKG" ] && [ -e "$BIN_PKG" ]; then
    echo "ok    pkgdev ($BIN_PKG)"
  else
    echo "warn  pkgdev not symlinked (run 'ag update' or 'ag install --pkg-only')"
  fi
  if [ -L "$BIN_MISSION" ] && [ -e "$BIN_MISSION" ]; then
    echo "ok    mission ($BIN_MISSION)"
  else
    echo "warn  mission not symlinked (run 'ag update')"
  fi
  ensure_path_in_rc || ok=0
  _hook_wired "lex-claude/usage" && echo "ok    usage hook wired" || echo "warn  usage hook not wired (skill tracking off). run 'ag update'"
  _hook_wired "lex-claude/direct" && echo "ok    direct hook wired (ag prompts run without the model)" || echo "warn  direct hook not wired (ag prompts go to the model). run 'ag update'"
  _hook_wired "lex-claude/digest" && echo "ok    digest hook wired" || echo "warn  digest hook not wired (rules recall off). run 'ag update'"
  _hook_wired "lex-claude/style" && echo "ok    style hook wired" || echo "warn  style hook not wired (em-dash check off). run 'ag update'"
  _hook_wired "lex-claude/succeed" && echo "ok    succession trigger wired (Stop → succeed.sh check)" || echo "warn  succession trigger not wired (token handoff off). run 'ag update'"
  { [ -x "$INSTALL_DIR/master.sh" ] && [ -x "$INSTALL_DIR/succeed.sh" ]; } && echo "ok    master.sh + succeed.sh present" || echo "warn  master.sh/succeed.sh missing (succession broken). run 'ag update'"
  command -v jq >/dev/null 2>&1 && echo "ok    jq present" || echo "warn  jq missing (cold-start check + succession judge run unverified). install jq"
  case "$(command claude auth status 2>/dev/null | jq -r '.loggedIn | tostring' 2>/dev/null)" in
    true)  echo "ok    claude logged in" ;;
    false) echo "warn  claude not logged in (cold-start check + succession judge cannot run). run 'claude auth login'" ;;
    *)     echo "ok    claude auth: unknown (old claude or no jq)" ;;
  esac
  [ -f "$INSTALL_DIR/DIGEST.md" ] && echo "ok    DIGEST.md present" || echo "warn  DIGEST.md missing (digest hook is a no-op). run 'ag update'"
  [ -f "$MODEL_FILE" ] && echo "ok    model pinned: $(cat "$MODEL_FILE")" || echo "ok    model: default"
  [ -f "$SKIP_FILE" ] && echo "ok    skip: on" || echo "ok    skip: off"
  [ -f "$BRAND_FILE" ] && echo "ok    brand: on ($(_brand_name))" || echo "ok    brand: off"
  [ -L "$BIN_BRAND" ] && echo "ok    $BRAND_CMD launcher ($BIN_BRAND)" || echo "warn  $BRAND_CMD launcher not linked (run 'ag update')"
  if command -v pmset >/dev/null 2>&1; then
    [ -f "$LID_RULE" ] && echo "ok    awake --lid rule ($LID_RULE)" || echo "ok    awake --lid: not set up (first 'ag awake --lid' installs the rule)"
    _sleep_disabled && echo "warn  SleepDisabled is 1: the lid will not sleep this Mac. 'ag awake status' shows if ag holds it"
  fi
  [ $ok -eq 1 ] && echo "all good." || { echo "issues. run: lex-claude install"; exit 1; }
}

cmd_usage() {
  local script="$SELF_DIR/usage.sh"
  [ -x "$script" ] || script="$INSTALL_DIR/usage.sh"
  [ -x "$script" ] || die "usage.sh not found (run 'ag update')"
  bash "$script" report
}

cmd_rag() {
  local script="$SELF_DIR/tools/ag-rag/ag_rag.py"
  [ -f "$script" ] || script="$INSTALL_DIR/tools/ag-rag/ag_rag.py"
  [ -f "$script" ] || die "ag_rag.py not found (run 'ag update')"
  command -v uv >/dev/null 2>&1 || die "uv not found"
  exec uv run -q "$script" "$@"
}

# Best-effort self-heal: re-point the identity symlink to the identity it names
# (recovers a dangling link). If the name can't be resolved, leave it for doctor.
_coldstart_heal() {
  local link="$1" tgt name
  tgt=$(readlink "$link" 2>/dev/null || true)
  name=$(basename "$tgt" .md 2>/dev/null)
  if [ -n "$name" ] && [ -f "$INSTALL_DIR/identities/$name.md" ]; then
    ln -sfn "$INSTALL_DIR/identities/$name.md" "$link" 2>/dev/null && echo "ag: re-pointed identity → $name" >&2
  fi
  return 0
}

# Hash of what decides the loaded context: identity, project CLAUDE.md chain,
# hook wiring, deployed lex-claude, claude binary, lang, launch flags. Hook output
# that varies per launch (état, memory) is not covered.
_coldstart_fingerprint() {
  local bin="$1" d="$PWD" f; shift
  {
    cat "$CLAUDE_DIR/CLAUDE.md"
    while :; do
      for f in "$d/CLAUDE.md" "$d/CLAUDE.local.md" "$d/.claude/CLAUDE.md"; do
        [ -f "$f" ] && { echo "== $f"; cat "$f"; }
      done
      [ "$d" = / ] && break
      d=$(dirname "$d")
    done
    jq -c '.hooks // {}' "$SETTINGS" 2>/dev/null
    git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null
    ls -lLn "$bin" | awk '{print $5,$6,$7,$8}'
    cat "$LANG_FILE" 2>/dev/null
    printf '%s\n' "$@"
  } | { shasum -a 256 2>/dev/null || sha256sum; } | cut -c1-16
}

# One TSV line per cold start: time, outcome (hit|fast|pass|fail|unverified),
# fingerprint, cwd, reason. Makes hit and failure rates measurable.
_coldstart_log() {
  mkdir -p "$COLDSTART_DIR" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-}" "$PWD" "${3:-}" >> "$COLDSTART_DIR/log" 2>/dev/null || true
}

# ag claude — cold-start supervisor. A hook cannot restart its own session, so
# the launcher owns the gate, and it verifies the REAL session, not a proxy: it
# runs the identity/rules self-report as turn 1 of a fresh persisted session, has
# the master judge THAT turn, rerolls a fresh session on failure (bounded), and
# hands over the session that PASSED via --resume (your work continues as turn
# 2+). Cheap symlink floor + self-heal first; never leaves the user without a
# shell. Preserves the model/skip flags.
# A PASS is cached per fingerprint of the loaded inputs: an unchanged setup opens
# straight away until LEX_CLAUDE_COLDSTART_TTL_HOURS (default 24, 0 = always
# check) runs out. --verify forces the check, --fast skips it (unverified).
# Opt out: LEX_CLAUDE_COLDSTART_DISABLE=1 (or LEX_CLAUDE_DISABLE=1).
cmd_claude() {
  # Resolve the real binary once. `exec command claude` only works where a
  # /usr/bin/command shim exists (macOS); Linux has none → "exec: command: not
  # found". type -P is path-only, so the rc router function is never re-entered.
  local claude_bin; claude_bin=$(type -P claude) || die "claude not found in PATH"
  local _f=()
  [ -f "$MODEL_FILE" ] && _f+=(--model "$(cat "$MODEL_FILE")")
  [ -f "$SKIP_FILE" ] && _f+=(--dangerously-skip-permissions)

  # --fast/--verify belong to ag, never to claude.
  local mode=auto a _args=()
  for a in "$@"; do
    case "$a" in
      --fast) mode=fast ;;
      --verify) mode=verify ;;
      *) _args+=("$a") ;;
    esac
  done
  set -- ${_args[@]+"${_args[@]}"}

  # Interactive hand-over. With `ag brand on` the seat runs behind brand.py;
  # it falls back to the bare binary when brand.py or uv is missing.
  _claude_exec() {
    local brand="$SELF_DIR/brand.py"; [ -f "$brand" ] || brand="$INSTALL_DIR/brand.py"
    if { [ -f "$BRAND_FILE" ] || [ "$BRAND_FORCE" = 1 ]; } && [ -f "$brand" ] && command -v uv >/dev/null 2>&1; then
      LEX_CLAUDE_BRAND_NAME="$(_brand_name)" exec uv run -q --no-project python -I "$brand" "$claude_bin" "$@"
    fi
    [ "$BRAND_FORCE" = 1 ] && echo "ag: brand.py or uv missing; launching the stock banner." >&2
    exec "$claude_bin" "$@"
  }

  # Only a FRESH interactive seat needs the cold-start check. Pass through
  # untouched: headless one-shots (-p/--print) and resumes/continues
  # (-r/--resume/-c/--continue) — resuming an existing session must not trigger a
  # verification turn (and would otherwise double the --resume flag).
  local a
  for a in "$@"; do
    case "$a" in
      -p|--print) exec "$claude_bin" ${_f[@]+"${_f[@]}"} "$@" ;;
    esac
  done
  for a in "$@"; do
    case "$a" in
      -r|--resume|-c|--continue) _claude_exec ${_f[@]+"${_f[@]}"} "$@" ;;
    esac
  done

  local master="$SELF_DIR/master.sh"; [ -x "$master" ] || master="$INSTALL_DIR/master.sh"
  if [ "${LEX_CLAUDE_DISABLE:-}" = "1" ] || [ "${LEX_CLAUDE_COLDSTART_DISABLE:-}" = "1" ] \
     || ! command -v jq >/dev/null 2>&1 || [ ! -x "$master" ]; then
    _claude_exec ${_f[@]+"${_f[@]}"} "$@"
  fi

  local link="$CLAUDE_DIR/CLAUDE.md" fp
  local ttl="${LEX_CLAUDE_COLDSTART_TTL_HOURS:-24}"; case "$ttl" in *[!0-9]*|"") ttl=24 ;; esac
  if [ "$mode" = fast ]; then
    [ -e "$link" ] || _coldstart_heal "$link"
    _coldstart_log fast
    _claude_exec ${_f[@]+"${_f[@]}"} "$@"
  fi
  if [ "$mode" = auto ] && [ "$ttl" -gt 0 ] && [ -L "$link" ] && [ -e "$link" ]; then
    fp=$(_coldstart_fingerprint "$claude_bin" ${_f[@]+"${_f[@]}"}) || fp=""
    if [ -n "$fp" ] && [ -n "$(find "$COLDSTART_DIR/pass/$fp" -mmin -$((ttl * 60)) 2>/dev/null)" ]; then
      _coldstart_log hit "$fp"
      _claude_exec ${_f[@]+"${_f[@]}"} "$@"
    fi
  fi

  # No auth → every -p turn returns an error blob, subject and judge alike.
  # Rerolling cannot fix that; hand the seat over so claude runs its login flow.
  if [ "$("$claude_bin" auth status 2>/dev/null | jq -r '.loggedIn | tostring' 2>/dev/null)" = "false" ]; then
    echo "ag: claude is not logged in. Skipping the cold-start check. Log in, then relaunch." >&2
    _coldstart_log unverified "" "not logged in"
    _claude_exec ${_f[@]+"${_f[@]}"} "$@"
  fi

  local max="${LEX_CLAUDE_SUCCESSION_MAX:-3}"; case "$max" in *[!0-9]*|"") max=3 ;; esac
  local pdir="$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's#[^A-Za-z0-9]#-#g')"
  # Private 0700 dir for the preflight files; no predictable /tmp fallback.
  local tmpd; tmpd=$(mktemp -d 2>/dev/null) \
    || { echo "ag: cannot create a temp dir; launching unverified." >&2; _coldstart_log unverified "" "no temp dir"; _claude_exec ${_f[@]+"${_f[@]}"} "$@"; }
  local tmp="$tmpd/answer"
  local prompt="In 6 lines max: state your identity (name) and your core non-negotiable rules, in your own words."

  local attempt=1 uuid
  while [ "$attempt" -le "$max" ]; do
    # Cheap floor first: a broken identity symlink means nothing will load. Heal
    # and retry before spending a turn.
    if [ ! -L "$link" ] || [ ! -e "$link" ]; then
      echo "ag: identity symlink missing/broken ($link), attempt $attempt/$max." >&2
      _coldstart_heal "$link"; attempt=$((attempt+1)); continue
    fi
    # Lowercase: claude names the jsonl in lowercase, and the rm below must hit it
    # on a case-sensitive volume too.
    uuid=$({ uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null; } | tr 'A-F' 'a-f')
    [ -n "$uuid" ] || { echo "ag: no uuid source; launching raw." >&2; rm -rf "$tmpd"; _coldstart_log unverified "" "no uuid source"; _claude_exec ${_f[@]+"${_f[@]}"} "$@"; }
    # Verify the REAL session: run the identity self-report as turn 1 of the
    # persisted session, judge THAT turn. set -e/pipefail: a failed turn rerolls.
    # Keep the failure reason: a silent 3/3 reroll is undebuggable.
    "$claude_bin" ${_f[@]+"${_f[@]}"} -p --output-format json --session-id "$uuid" "$prompt" 2>"$tmp.err" > "$tmp.raw" || true
    # -p reports API/auth failures as {"is_error":true,"result":"<message>"} with
    # exit 0. That is not identity drift: judging it or rerolling is pointless.
    if [ "$(jq -r '.is_error // false' "$tmp.raw" 2>/dev/null)" = "true" ]; then
      echo "ag: preflight turn errored: $(jq -r '.result // empty' "$tmp.raw" | head -c 200). Launching unverified." >&2
      rm -rf "$tmpd" "$pdir/$uuid.jsonl" 2>/dev/null || true
      _coldstart_log unverified "" "preflight turn errored"
      _claude_exec ${_f[@]+"${_f[@]}"} "$@"
    fi
    jq -r '.result // empty' "$tmp.raw" > "$tmp" 2>/dev/null || true
    local reason
    if [ ! -s "$tmp" ]; then
      reason="preflight turn produced no answer: $(tail -n1 "$tmp.err" 2>/dev/null || echo 'no stderr')"
    elif reason=$("$master" verify --answer "$tmp" --phase identity 2>"$tmp.merr"); then
      rm -rf "$tmpd"
      fp=$(_coldstart_fingerprint "$claude_bin" ${_f[@]+"${_f[@]}"}) || fp=""
      if [ -n "$fp" ] && mkdir -p "$COLDSTART_DIR/pass" 2>/dev/null; then
        touch "$COLDSTART_DIR/pass/$fp" 2>/dev/null || true
        [ "$ttl" -gt 0 ] && find "$COLDSTART_DIR/pass" -type f -mmin +$((ttl * 60)) -delete 2>/dev/null
      fi
      _coldstart_log pass "$fp"
      # Hand over the verified session itself; your work continues as turn 2+.
      _claude_exec ${_f[@]+"${_f[@]}"} --resume "$uuid" "$@"
    else
      reason="master: $(printf '%s' "$reason" | jq -r '.reason // empty' 2>/dev/null || printf '%s' "$reason")"
      # An empty verdict means the judge itself broke: show why instead of "master: ."
      [ "$reason" = "master: " ] && reason="master error: $(tail -n1 "$tmp.merr" 2>/dev/null | cut -c1-200)"
    fi
    echo "ag: cold-start check failed (attempt $attempt/$max): $reason. Rerolling a fresh session." >&2
    _coldstart_log fail "" "$(printf '%s' "$reason" | tr '\t\n' '  ' | cut -c1-200)"
    rm -f "$pdir/$uuid.jsonl" 2>/dev/null || true    # discard the rejected session
    _coldstart_heal "$link"
    attempt=$((attempt+1))
  done
  rm -rf "$tmpd"
  echo "ag: WARNING: cold-start verification failed $max times. Identity load looks structurally broken; run 'ag doctor'. Launching anyway (unverified)." >&2
  _coldstart_log unverified "" "failed $max times"
  _claude_exec ${_f[@]+"${_f[@]}"} "$@"
}

# Called as the brand launcher: a branded `ag claude`, whatever `ag brand` says.
BRAND_FORCE=0
if [ "$(basename "$0")" = "$BRAND_CMD" ]; then
  BRAND_FORCE=1
  set -- claude "$@"
fi

case "${1:-}" in
  install|update|__deploy|identity|rules|model|lang|skip|brand|version|github-login|awake|codex|claude|init|rag|doctor|usage|-v|--version|-h|-help|--help|help|"") ;;
  *) auto_update "$@" ;;
esac

# usage trace — record the top-level command so the never-used surface is data,
# not a guess. Best-effort: a logging failure must never block the command.
case "${1:-}" in
  -v|--version)            usage_cmd=version ;;
  -h|-help|--help|help|"") usage_cmd="" ;;
  init)                    usage_cmd="" ;;   # plumbing: auto-fired by shell completion + SessionStart, never debloatable
  __deploy)                usage_cmd="" ;;   # plumbing: post-pull re-exec from update/auto_update
  *)                       usage_cmd="${1:-}" ;;
esac
if [ -n "$usage_cmd" ]; then
  usage_sh="$SELF_DIR/usage.sh"; [ -x "$usage_sh" ] || usage_sh="$INSTALL_DIR/usage.sh"
  [ -x "$usage_sh" ] && bash "$usage_sh" log cli "$usage_cmd" 2>/dev/null || true
fi

case "${1:-}" in
  install)      shift; cmd_install "$@" ;;
  update)       shift; cmd_update "$@" ;;
  __deploy)     shift; deploy; echo "updated." ;;
  identity)     shift; cmd_identity "$@" ;;
  rules)        shift; cmd_rules "$@" ;;
  model)        shift; cmd_model "$@" ;;
  lang)         shift; cmd_lang "$@" ;;
  skip)         shift; cmd_skip "$@" ;;
  brand)        shift; cmd_brand "$@" ;;
  github-login) shift; cmd_github_login "$@" ;;
  awake)        shift; cmd_awake "$@" ;;
  codex)        shift; cmd_codex "$@" ;;
  claude)       shift; cmd_claude "$@" ;;
  init)         shift; cmd_init "$@" ;;
  doctor)       shift; cmd_doctor "$@" ;;
  rag)          shift; cmd_rag "$@" ;;
  usage)        shift; cmd_usage "$@" ;;
  journal)      shift; bash "$INSTALL_DIR/journal.sh" "$@" ;;
  version|-v|--version) cmd_version ;;
  -h|-help|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
